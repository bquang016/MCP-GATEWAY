{
  "name": "dual-agent-workflow-gateway",
  "version": "5.3.0",
  "description": "Local MCP gateway coordinating planning, execution, handoff, review and context recovery across ChatGPT, Codex and Antigravity.",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dashboard": "node dist/dashboard.js",
    "check": "npm run build && npm test",
    "install:codex": "powershell -ExecutionPolicy Bypass -File ./scripts/install-codex-mcp.ps1 -ConfirmInstall"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "codex",
    "antigravity",
    "ai-agent"
  ],
  "author": "Quang Dang",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bquang016/MCP-GATEWAY.git"
  },
  "bugs": {
    "url": "https://github.com/bquang016/MCP-GATEWAY/issues"
  },
  "homepage": "https://github.com/bquang016/MCP-GATEWAY#readme",
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openai": "^7.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
